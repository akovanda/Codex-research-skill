          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "ClientReference",
      "type": "object"
    },
    "DepositClaim": {
      "additionalProperties": false,
      "properties": {
        "canonical_key": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
