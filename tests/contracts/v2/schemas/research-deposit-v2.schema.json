    "CharRangeSelector": {
      "additionalProperties": false,
      "properties": {
        "deep_link": {
          "anyOf": [
            {
              "maxLength": 4096,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deep Link"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "integer"
        },
        "exact": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Exact",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "type": {
