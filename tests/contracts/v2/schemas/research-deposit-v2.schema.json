          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "start",
        "end",
        "exact"
      ],
      "title": "CharRangeSelector",
      "type": "object"
    },
    "ClaimEvidenceLink": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdReference"
            },
            {
              "$ref": "#/$defs/ClientReference"
            }
          ],
          "title": "Evidence"
        },
        "rationale": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "relationship": {
          "enum": [
            "supports",
            "refutes",
            "qualifies",
            "contextualizes"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "weight": {
          "default": 1.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "evidence",
        "relationship"
      ],
      "title": "ClaimEvidenceLink",
      "type": "object"
    },
    "ClientReference": {
      "additionalProperties": false,
