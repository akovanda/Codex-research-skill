    "DepositEvidence": {
      "additionalProperties": false,
      "properties": {
        "client_ref": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Client Ref",
          "type": "string"
        },
        "confidence": {
          "default": 0.75,
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 50,
          "title": "Metadata",
          "type": "object"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 10000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "quote_text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Quote Text",
          "type": "string"
        },
        "review_state": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "reviewed",
            "flagged"
          ],
          "title": "Review State",
          "type": "string"
        },
        "selector": {
          "discriminator": {
            "mapping": {
              "char_range": "#/$defs/CharRangeSelector",
              "dom_text": "#/$defs/DomTextSelector",
              "git_line_range": "#/$defs/GitLineRangeSelector",
              "json_pointer": "#/$defs/JsonPointerSelector",
              "line_range": "#/$defs/LineRangeSelector",
              "page_range": "#/$defs/PageRangeSelector",
              "text_quote": "#/$defs/TextQuoteSelector"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TextQuoteSelector"
            },
            {
              "$ref": "#/$defs/LineRangeSelector"
            },
            {
              "$ref": "#/$defs/GitLineRangeSelector"
            },
            {
              "$ref": "#/$defs/PageRangeSelector"
            },
            {
              "$ref": "#/$defs/CharRangeSelector"
            },
            {
              "$ref": "#/$defs/JsonPointerSelector"
            },
            {
              "$ref": "#/$defs/DomTextSelector"
            }
          ],
          "title": "Selector"
        },
        "source_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/IdReference"
            },
            {
              "$ref": "#/$defs/ClientReference"
            }
          ],
          "title": "Source Version"
        },
        "trust_tier": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Trust Tier",
          "type": "string"
        }
      },
      "required": [
        "client_ref",
        "source_version",
        "quote_text",
        "selector"
      ],
      "title": "DepositEvidence",
      "type": "object"
    },
