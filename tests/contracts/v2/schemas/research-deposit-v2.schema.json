        },
        "client_ref": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Client Ref",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ClaimEvidenceLink"
          },
          "maxItems": 100,
          "title": "Evidence",
          "type": "array"
        },
        "expected_revision_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Revision Id"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 50,
          "title": "Metadata",
          "type": "object"
        },
        "scope": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "maxProperties": 50,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "statement": {
          "maxLength": 50000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
