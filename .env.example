RESEARCH_REGISTRY_DATABASE_URL=sqlite:////app/.data/registry.sqlite3
RESEARCH_REGISTRY_ADMIN_TOKEN=change-me
RESEARCH_REGISTRY_SESSION_SECRET=change-me-too
RESEARCH_REGISTRY_HOST=0.0.0.0
RESEARCH_REGISTRY_PORT=8000
RESEARCH_REGISTRY_PUBLIC_BASE_URL=http://127.0.0.1:8000

# External capture is off unless explicitly enabled by the machine operator.
# RESEARCH_REGISTRY_CAPTURE_MODES=capture
# RESEARCH_REGISTRY_CAPTURE_SNAPSHOT_POLICY=evidence_only
# RESEARCH_REGISTRY_CAPTURE_ALLOW_HTTP=false
# RESEARCH_REGISTRY_CAPTURE_GIT_ROOTS=/absolute/allowed/root
# RESEARCH_REGISTRY_CAPTURE_GIT_REPOSITORIES={"repository-id":"/absolute/allowed/root/repo"}
